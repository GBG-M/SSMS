# ==============================================================================
# SSMS - Environment Configuration Template
# ==============================================================================

# Core Django Security
# Generate a secure key in production with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-very-long-random-secret-key-in-production
DEBUG=True

# Networking & Hosts
# Comma-separated list of allowed hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# CSRF Trusted Origins (Comma-separated HTTPS origins)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com

# CORS Configuration
# Leave blank to allow all origins in development, or supply specific comma-separated URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL / MySQL / SQLite)
# If left blank or unset, Django defaults to local SQLite db.sqlite3
# Example: postgres://username:password@localhost:5432/ssms_db
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Email Service (SMTP / Notifications / Password Reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=SSMS Support <noreply@ssms.com>
